# Sourced by the base nginx image's own entrypoint (docker-entrypoint.d/*.envsh
# convention) before 20-envsubst-on-templates.sh runs. Computes the Basic-Auth
# token for the auth-injecting Orthanc proxy (see default.conf.template) from
# ORTHANC_USER/ORTHANC_PASSWORD at container start, instead of a hardcoded
# base64 string baked into a file committed to git.
export ORTHANC_AUTH_B64
ORTHANC_AUTH_B64="$(printf '%s:%s' "${ORTHANC_USER:-orthanc}" "${ORTHANC_PASSWORD:?ORTHANC_PASSWORD must be set (see .env.example)}" | base64 -w0)"

# Edge rate limit for /api/ (default is the PRODUCTION value; only test harnesses
# may raise it via environment -- the deployment composes pass it through with this
# same default, and 20-envsubst-on-templates.sh can therefore never see the variable
# unset and emit a rate=${API_RATE_LIMIT} literal into the nginx config).
: "${API_RATE_LIMIT:=10r/s}"
# Fail here with a readable message instead of letting nginx refuse to
# start later with its own opaque config error.
if [[ ! "$API_RATE_LIMIT" =~ ^[0-9]+r/[sm]$ ]]; then
  echo "API_RATE_LIMIT must be <number>r/s or <number>r/m, got: '$API_RATE_LIMIT'" >&2
  exit 1
fi
export API_RATE_LIMIT
