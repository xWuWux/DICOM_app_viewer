# Copy this file to .env (already gitignored) and fill in real values.
# Never commit .env itself.
#
# Generate one with: openssl rand -hex 16
ORTHANC_PASSWORD=

# Shared secret between grading-api and scripts/create-session.py -- the
# only thing allowed to mint a grading-api session token (POST /session).
# Without this, any client could mint its own token for any student_id and
# recreate the exact authorization gap this token system exists to close.
# Generate one with: openssl rand -hex 32
GRADING_COORDINATOR_KEY=

# Only needed for the Guacamole PoC (docker-compose.guacamole.yml) --
# password for Guacamole's own required JDBC auth database (Postgres),
# unrelated to grading-api's own SQLite database.
# Generate one with: openssl rand -hex 16
GUACAMOLE_DB_PASSWORD=
