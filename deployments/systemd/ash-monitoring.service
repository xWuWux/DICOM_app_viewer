[Unit]
Description=DICOM App Viewer Monitoring Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/wojtek/Projects/DICOM_app_viewer
EnvironmentFile=-/home/wojtek/Projects/DICOM_app_viewer/.env
ExecStartPre=/home/wojtek/Projects/DICOM_app_viewer/scripts/monitoring-init.sh
ExecStart=/usr/bin/docker compose --profile monitoring up -d --wait
ExecStop=/usr/bin/docker compose --profile monitoring down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
